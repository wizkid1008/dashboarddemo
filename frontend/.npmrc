# Pin all installed packages to exact versions — no ^ or ~ ranges written on npm install --save.
# Prevents accidental upgrades into malicious versions if the lock file is deleted.
save-exact=true

# Block installation of any package version published less than 7 days ago.
# Defends against zero-day supply chain attacks (e.g. TanStack May 2026 attack was live < 20 min).
# Override for an urgent security patch: npm install <pkg>@<ver> --min-release-age=0
min-release-age=7
