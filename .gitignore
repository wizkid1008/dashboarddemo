# Local/demo repo hygiene
.env
.env.*
!.env.example

# Dependencies and build outputs
node_modules/
dist/
build/
.next/
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Microsoft Office temporary lock files
~$*
*.tmp

